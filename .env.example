# ─────────────────────────────────────────────
# AbejaVerde·EO — Variables de entorno
# Copie este archivo como .env y complete los valores
# NUNCA suba el archivo .env al repositorio
# ─────────────────────────────────────────────

# Copernicus Data Space Ecosystem (CDSE)
# Registro gratuito en: https://dataspace.copernicus.eu
CDSE_USERNAME=su_usuario@email.com
CDSE_PASSWORD=su_contraseña

# Copernicus Climate Data Store (CDS) — para ERA5-Land
# Registro gratuito en: https://cds.climate.copernicus.eu
CDS_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Coordenadas del apiario piloto
APIARIO_LAT=4.875
APIARIO_LON=-74.635
APIARIO_NOMBRE=San_Juan_de_Rioseco_Piloto

# Radio de análisis
RADIO_AGUA_M=500
RADIO_REUBICACION_KM=10

# Umbrales IRA
IRA_UMBRAL_MEDIO=34
IRA_UMBRAL_ALTO=67

# Notificaciones (opcional para hackathon)
WHATSAPP_API_KEY=
WHATSAPP_PHONE=
